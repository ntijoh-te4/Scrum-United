<main>
    <%= for item <- cart do %>
        <div class="pizza">

            <div class="pizzaInfo">
                <h3><%= item.pizza %></h3>
                <div class="ingContainer">
                    <%= for topping <- item.toppings do %>
                        <%= topping %><br>
                    <% end %>
                </div>
                <div class="buttonContainer">
                    <form action="" method="get">
                        <button class="anpassa">Anpassa</button>
                    </form>
                    <form method="POST" action="/cart/remove/<%= item.order %>">
                        <button class="remove" type="submit"> Remove </button>
                    </form>
                </div>
            </div>
        </div>
    <% end %>
</main>

<p>

<form method="POST" action="/cart/submit">
    <button class="submit" type="submit"> Submit </button>
</form>
